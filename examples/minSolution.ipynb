      "(Compiled) MappingExample.4ml\n",
      "0.58s.\n"
     ]
    },
    {
     "data": {
      "text/plain": [
       "'domain Mapping\\n{\\n  Component ::= new (id: Integer, utilization: Real).\\n  Processor ::= new (id: Integer).\\n  Mapping   ::= new (c: Component, p: Processor).\\n\\n  // The utilization must be > 10\\n  invalidUtilization :- c is Component, c.utilization <= 10.\\n\\n  badMapping :- p is Processor, \\n\\t\\ts = sum(0.0, { c.utilization |\\n\\t\\t\\t       c is Component, Mapping(c, p) }), s > 100.\\n\\n  conforms no badMapping, no invalidUtilization.\\n}\\n\\npartial model pm of Mapping\\n{\\n  c1 is Component(0, x).\\n  c2 is Component(1, y).\\n  p1 is Processor(0).\\n  p2 is Processor(1).\\n  Mapping(c1, p1).\\n  Mapping(c2, p1).\\n}'"
      ]
     },
     "execution_count": 2,
     "metadata": {},
     "output_type": "execute_result"
    }
   ],
   "source": [
    "f.load(\"./data/MappingExample.4ml\")"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 3,
   "metadata": {},
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "Parsing text took: 1\n",
      "Visiting text took: 0\n",
      "Started solve task with Id 0.\n",
      "0.32s.\n"
     ]
    }
   ],
   "source": [
    "f.solve(\"pm\",\"1\",\"Mapping.conforms\")"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 4,
   "metadata": {},
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "(=> UC_0 (or (not P2_2) (> (+ pm@~SC2VAR~y pm@~SC2VAR~x) 100.0)))\n",
      "(let ((a!1 (or P2_2 (not (> (+ pm@~SC2VAR~y pm@~SC2VAR~x) 100.0)))))\n",
      "  (=> UC_1 a!1))\n",
      "(=> UC_2 (or P1_1 P2_2))\n",
      "(=> UC_3 (or (not P1_1) (not P2_2)))\n",
      "(=> UC_4 (or (not P3_5) (<= pm@~SC2VAR~x 10.0)))\n",
      "(=> UC_5 (or P3_5 (not (<= pm@~SC2VAR~x 10.0))))\n",
      "(=> UC_6 (or (not P3_6) (<= pm@~SC2VAR~y 10.0)))\n",
      "(=> UC_7 (or P3_6 (not (<= pm@~SC2VAR~y 10.0))))\n",
      "(=> UC_8 (or P3_5 P3_6 (not P2_4)))\n",
      "(=> UC_9 (or (not P3_5) P2_4))\n",
      "(=> UC_10 (or (not P3_6) P2_4))\n",
      "(=> UC_11 (or P1_3 P2_4))\n",
      "(=> UC_12 (or (not P1_3) (not P2_4)))\n",
      "(=> UC_13 (or (not P0_0) P1_1))\n",
      "(=> UC_14 (or (not P0_0) P1_3))\n",
      "(=> UC_15 (or (not P1_1) (not P1_3) P0_0))\n",
      "(=> UC_16 P0_0)\n",
      "\n",
      "0.01s.\n"
     ]
    }
   ],
